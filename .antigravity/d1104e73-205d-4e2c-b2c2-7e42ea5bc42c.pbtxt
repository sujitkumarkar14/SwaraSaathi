    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    // Setup the system instructions prompt\n    const systemInstruction = `You are a dual-purpose mental health AI system. Your role is to empathetically respond to patients in distress while simultaneously generating clinical triage data for medical professionals.\n\nYou will receive raw input from a patient (either text or transcribed audio). If you receive raw audio, analyze the speech content to transcribe it and derive clinical notes.\n\nYou must output a strictly formatted JSON object and nothing else. Follow the responseSchema exactly.\nThe patient_response is spoken directly to the patient to validate their feelings and offer a gentle micro-intervention.\nThe clinician_summary contains a clinical observation, risk level, primary stressor, and transcript.\nThe crisis_trigger must be set to true ONLY if the patient expresses clear, immediate intent for self-harm, suicide, or physical danger. Otherwise false. Default to false unless the threat is high or active.`;\n\n    // Define response schema\n    const responseSchema = {\n      type: Type.OBJECT,\n      properties: {\n        patient_response: {\n          type: Type.STRING,\n          description: \"A short, empathetic, non-clinical response spoken directly to the patient to validate their feelings and offer a warm micro-intervention.\"\n        },\n        clinician_summary: {\n          type: Type.OBJECT,\n          properties: {\n            primary_stressor: {\n              type: Type.STRING,\n              description: \"1-3 word summary of the main issue (e.g. Work burnout, Family grief, Financial stress)\"\n            },\n            risk_level: {\n              type: Type.STRING,\n              description: \"Risk level of the patient. Must be one of: \'Low\', \'Medium\', or \'High\'.\"\n            },\n            clinical_notes: {\n              type: Type.STRING,\n              description: \"A brief, professional clinical observation of the patient\'s state for medical professionals. Focus on coping indicators or distress levels.\"\n            },\n            transcript: {\n              type: Type.STRING,\n              description: \"A verbatim transcript of what was recorded in the audio, or a copy of the input text if text was submitted.\"\n            }\n          },\n          required: [\"primary_stressor\", \"risk_level\", \"clinical_notes\", \"transcript\"]\n        },\n        crisis_trigger: {\n          type: Type.BOOLEAN,\n          description: \"Set to true ONLY if the patient expresses a clear, immediate intent for self-harm, suicide, or active physical danger. Otherwise false.\"\n        }\n      },\n      required: [\"patient_response\", \"clinician_summary\", \"crisis_trigger\"]\n    };\n\n    if (audio) {\n      // Audio is submitted as a base64 string\n      parts.push({\n        inlineData: {\n          data: audio,\n          mimeType: mimeType || \'audio/webm\'\n        }\n      });\n      parts.push({\n        text: \"Analyze this recorded patient voice journal. Transcribe it verbatim inside clinician_summary.transcript, formulate an empathetic response for the patient, and write professional clinical notes for the doctor. Determine if a crisis trigger is present.\"\n      });\n    } else if (text) {\n      // Text is submitted\n      parts.push({\n        text: `Here is the written patient journal: \"${text}\"\\n\\nAnalyze this journal, complete the transcript field with the exact text input, compose the empathetic patient_response, and formulate the clinician_summary.`\n      });\n    }\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.5-flash\',\n      contents: parts,\n      config: {\n        systemInstruction,\n        responseMimeType: \'application/json\',\n        responseSchema,\n        temperature: 0.2\n      }\n    });"
      replacement_content: "    // Setup the system instructions prompt\n    const systemInstruction = `You are a dual-role clinical triage engine. You are designed to empathetically support patients in distress while generating professional clinical summaries and risk levels for medical practitioners.\n\nYou will receive an inline audio/wav stream of the patient\'s voice or a written journal text.\nYour task is to analyze the patient\'s input.\nCompose an empathetic patient response, transcribe the speech verbatim, and write professional clinical triage notes including risk levels and primary stressors.\nYou must return a strictly conforming JSON object according to the requested responseSchema.\nSet \'crisis_trigger\' to true ONLY if there is an immediate risk of self-harm, active suicide intent, or physical danger. Otherwise, set it to false.`;\n\n    // Define response schema\n    const responseSchema = {\n      type: Type.OBJECT,\n      properties: {\n        patient_response: {\n          type: Type.STRING,\n          description: \"An empathetic response directly to the patient validating their experience.\"\n        },\n        clinician_summary: {\n          type: Type.OBJECT,\n          properties: {\n            primary_stressor: {\n              type: Type.STRING,\n              description: \"The primary psychological stressor identified from user input (e.g. Work Burnout, Family Stress, Suicidal Ideation).\"\n            },\n            risk_level: {\n              type: Type.STRING,\n              description: \"Assessed level of clinical risk. Must be one of: \'Low\', \'Medium\', or \'High\'.\"\n            },\n            clinical_notes: {\n              type: Type.STRING,\n              description: \"Professional clinical formulation notes for medical practitioners.\"\n            },\n            transcript: {\n              type: Type.STRING,\n              description: \"Verbatim transcript of the voice audio; or a copy of the input text if text was provided.\"\n            }\n          },\n          required: [\"primary_stressor\", \"risk_level\", \"clinical_notes\", \"transcript\"]\n        },\n        crisis_trigger: {\n          type: Type.BOOLEAN,\n          description: \"Set to true ONLY if there is an immediate risk of self-harm, suicide, or active physical danger.\"\n        }\n      },\n      required: [\"patient_response\", \"clinician_summary\", \"crisis_trigger\"]\n    };\n\n    if (audio) {\n      // Audio is submitted as a base64 string\n      parts.push({\n        inlineData: {\n          data: audio,\n          mimeType: \'audio/wav\'\n        }\n      });\n      parts.push({\n        text: \"Analyze this raw recorded patient voice audio to compose the empathetic response, transcribe it verbatim, draft the clinical summary, and evaluate the crisis trigger.\"\n      });\n    } else if (text) {\n      // Text is submitted\n      parts.push({\n        text: `Here is the written patient journal: \"${text}\"\\n\\nAnalyze this journal, complete the transcript field with the exact text input, compose the empathetic patient_response, and formulate the clinician_summary.`\n      });\n    }\n\n    const response = await ai.models.generateContent({\n      model: \'gemma-4-e4b-it\',\n      contents: parts,\n      config: {\n        systemInstruction,\n        responseMimeType: \'application/json\',\n        responseSchema,\n        temperature: 0.2\n      }\n    });"
    }
