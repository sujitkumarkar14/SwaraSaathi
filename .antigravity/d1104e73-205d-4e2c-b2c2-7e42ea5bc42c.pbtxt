0 rounded-xl text-left\">\n                    <span className=\"text-[9px] font-bold font-mono text-red-400 block tracking-wider uppercase mb-1\">Verbatim Transcript Detected</span>\n                    <p className=\"text-xs text-zinc-300 italic leading-relaxed\">\n                      \"{crisisAssessment.clinician_summary.transcript}\"\n                    </p>\n                  </div>\n                )}\n\n                {/* Massive Red Hotlinks */}\n                <div className=\"space-y-3 mt-6\">\n                  <a\n                    id=\"link-telemanas\"\n                    href=\"tel:14416\"\n                    className=\"w-full h-14 bg-red-600 hover:bg-red-700 text-white font-semibold text-lg flex items-center justify-center gap-3.5 rounded-xl border border-red-500/40 shadow-lg shadow-red-600/15 group transition-all\"\n                  >\n                    <PhoneCall className=\"w-5 h-5 group-hover:animate-bounce\" />\n                    Call Tele MANAS (14416)\n                  </a>\n                  \n                  <a\n                    id=\"link-emergency\"\n                    href=\"tel:112\"\n                    className=\"w-full h-14 bg-orange-600 hover:bg-orange-700 text-white font-semibold text-lg flex items-center justify-center gap-3.5 rounded-xl border border-orange-500/40 shadow-lg shadow-orange-600/15 group transition-all\"\n                  >\n                    <PhoneCall className=\"w-5 h-5 group-hover:animate-bounce\" />\n                    Call National Emergency (112)\n                  </a>\n                </div>\n\n                <div className=\"mt-8 pt-5 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-500\">\n                  <span className=\"font-mono\">Triage Code: Esc-14416</span>\n                  \n                  {/* Exit bypass strictly for debug/testing/demonstration triage flows */}\n                  <button\n                    id=\"btn-close-crisis-modal\"\