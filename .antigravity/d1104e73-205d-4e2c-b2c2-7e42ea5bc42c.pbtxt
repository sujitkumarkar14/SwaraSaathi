  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useEffect, useRef } from \'react\';\nimport { \n  Mic, \n  Square, \n  Send, \n  Activity, \n  ShieldAlert, \n  Sparkles, \n  RefreshCw, \n  Search, \n  User, \n  Clock, \n  Trash2, \n  Volume2, \n  VolumeX, \n  FileText, \n  CheckCircle,\n  AlertTriangle,\n  Server,\n  Filter,\n  UserCheck,\n  PhoneCall,\n  Heart,\n  ExternalLink\n} from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\ninterface ClinicianSummary {\n  primary_stressor: string;\n  risk_level: string; // \'Low\', \'Medium\', \'High\'\n  clinical_notes: string;\n  transcript: string;\n}\n\ninterface Assessment {\n  id: string;\n  timestamp: string;\n  patient_response: string;\n  clinician_summary: ClinicianSummary;\n  crisis_trigger: boolean;\n  acknowledged?: boolean;\n}\n\nexport default function App() {\n  // General Platform States\n  const [activeTab, setActiveTab] = useState<\'patient\' | \'clinician\'>(\'patient\');\n  const [triageHistory, setTriageHistory] = useState<Assessment[]>([]);\n  const [isApiKeyMissing, setIsApiKeyMissing] = useState<boolean>(false);\n  \n  // Patient View States\n  const [journalText, setJournalText] = useState<string>(\'\');\n  const [isRecording, setIsRecording] = useState<boolean>(false);\n  const [recordingSeconds, setRecordingSeconds] = useState<number>(0);\n  const [micVolume, setMicVolume] = useState<number>(0);\n  const [micError, setMicError] = useState<string | null>(null);\n  const [isSubmitting, setIsSubmitting] = useState<boolean>(false);\n  const [patientResponseBubble, setPatientResponseBubble] = useState<Assessment | null>(null);\n  \n  // Crisis Modal States\n  const [showCrisisModal, setShowCrisisModal] = useState<boolean>(false);\n  const [crisisAssessment, setCrisisAssessment] = useState<Assessment | null>(null);\n  const [ttsPlaying, setTtsPlaying] = useState<boolean>(false);\n\n  // Clinician Dashboard States\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [riskFilter, setRiskFilter] = useState<\'All\' | \'Low\' | \'Medium\' | \'High\'>(\'All\');\n  const [activeCardId, setActiveCardId] = useState<string | null>(null);\n\n  // Media Capture Refs\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\n  const audioChunksRef = useRef<Blob[]>([]);\n  const audioContextRef = useRef<AudioContext | null>(null);\n  const analyserRef = useRef<AnalyserNode | null>(null);\n  const animationFrameRef = useRef<number | null>(null);\n  const recordingTimerRef = useRef<any>(null);\n\n  // Initialize and Fetch triage history\n  useEffect(() => {\n    fetchHistory();\n    // Set up polling interval to fetch clinician logs\n    const interval = setInterval(fetchHistory, 10000); // Poll every 10s\n    return () => clearInterval(interval);\n  }, []);\n\n  // Update recording timer\n  useEffect(() => {\n    if (isRecording) {\n      recordingTimerRef.current = setInterval(() => {\n        setRecordingSeconds(prev => prev + 1);\n      }, 1000);\n    } else {\n      if (recordingTimerRef.current) {\n        clearInterval(recordingTimerRef.current);\n      }\n      setRecordingSeconds(0);\n    }\n    return () => {\n      if (recordingTimerRef.current) clearInterval(recordingTimerRef.current);\n    };\n  }, [isRecording]);\n\n  const fetchHistory = async () => {\n    try {\n      const res = await fetch(\'/api/triage-history\');\n      if (res.ok) {\n        const data = await res.json();\n        setTriageHistory(data);\n        // Clean key missing state if history gets fetched perfectly\n        setIsApiKeyMissing(false);\n      }\n    } catch (err) {\n      console.error(\"Failed to load triage assessments history:\", err);\n    }\n  };\n\n  // Convert seconds to readable min:sec\n  const formatTime = (secs: number) => {\n    const mins = Math.floor(secs / 60);\n    const remaining = secs % 60;\n    return `${mins}:${remaining.toString().padStart(2, \'0\')}`;\n  };\n\n  // Web Audio Recording Handlers\n  const startRecording = async () => {\n    setMicError(null);\n    audioChunksRef.current = [];\n    setPatientResponseBubble(null);\n    \n    try {\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n      setIsRecording(true);\n      setRecordingSeconds(0);\n      \n      // Set up recorder\n      let recorder: MediaRecorder;\n      try {\n        recorder = new MediaRecorder(stream, { mimeType: \'audio/webm\' });\n      } catch (e) {\n        // Fallback for Safari or browsers that do not support webm audio codec\n        try {\n          recorder = new MediaRecorder(stream, { mimeType: \'audio/mp4\' });\n        } catch (innerErr) {\n          recorder = new MediaRecorder(stream);\n        }\n      }\n      \n      mediaRecorderRef.current = recorder;\n      \n      recorder.ondataavailable = (event) => {\n        if (event.data.size > 0) {\n          audioChunksRef.current.push(event.data);\n        }\n      };\n      \n      recorder.onstop = async () => {\n        setIsSubmitting(true);\n        const audioBlob = new Blob(audioChunksRef.current, { type: recorder.mimeType });\n        \n        // Convert Blob to base64 to send inside the strict JSON API request\n        const reader = new FileReader();\n        reader.readAsDataURL(audioBlob);\n        reader.onloadend = async () => {\n          const rawBase64 = reader.result as string;\n          const base64Audio = rawBase64.split(\',\')[1];\n          \n          await submitJournal({ \n            audio: base64Audio, \n            mimeType: recorder.mimeType \n          });\n        };\n        \n        // Quietly close stream capture tracks\n        stream.getTracks().forEach(track => track.stop());\n      };\n      \n      recorder.start(150); // Get chunks of data every 150ms\n      \n      // Setting up Web Audio API Frequency Spectrum analyzer\n      try {\n        const AudioContextConstructor = window.AudioContext || (window as any).webkitAudioContext;\n        const audioCtx = new AudioContextConstructor();\n        const source = audioCtx.createMediaStreamSource(stream);\n        const analyser = audioCtx.createAnalyser();\n        analyser.fftSize = 32;\n        source.connect(analyser);\n        \n        audioContextRef.current = audioCtx;\n        analyserRef.current = analyser;\n        \n        const bufferLength = analyser.frequencyBinCount;\n        const dataArray = new Uint8Array(bufferLength);\n        \n        const updateVisuals = () => {\n          if (!analyserRef.current) return;\n          analyserRef.current.getByteFrequencyData(dataArray);\n          let sum = 0;\n          for (let i = 0; i < bufferLength; i++) {\n            sum += dataArray[i];\n          }\n          const averageVolume = sum / bufferLength;\n          setMicVolume(averageVolume); // Normal ranges around 0-100\n          animationFrameRef.current = requestAnimationFrame(updateVisuals);\n        };\n        updateVisuals();\n      } catch (e) {\n        console.warn(\"Speech visualization not supported in iframe sandbox context.\", e);\n      }\n      \n    } catch (err: any) {\n      console.error(\"Mic hook error:\", err);\n      setMicError(\"Microphone access denied or unsupported in this sandbox. Please use the text entry method below or open the applet in a new window tab.\");\n      setIsRecording(false);\n    }\n  };\n\n  const stopRecording = () => {\n    if (mediaRecorderRef.current && isRecording) {\n      mediaRecorderRef.current.stop();\n      setIsRecording(false);\n      \n      if (animationFrameRef.current) {\n        cancelAnimationFrame(animationFrameRef.current);\n      }\n      if (audioContextRef.current) {\n        audioContextRef.current.close().catch(() => {});\n      }\n      setMicVolume(0);\n    }\n  };\n\n  // Submit Text or Audio voice to Express backend\n  const submitJournal = async (payload: { text?: string; audio?: string; mimeType?: string }) => {\n    setIsSubmitting(true);\n    setPatientResponseBubble(null);\n    setMicError(null);\n    setIsApiKeyMissing(false);\n    \n    try {\n      const response = await fetch(\'/api/analyze-journal\', {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload),\n      });\n      \n      const data = await response.json();\n      \n      if (!response.ok) {\n        if (data.isApiKeyError) {\n          setIsApiKeyMissing(true);\n        }\n        throw new Error(data.error || \"Failed to analyze state metrics.\");\n      }\n      \n      // Update historical logs in UI\n      await fetchHistory();\n      \n      if (data.crisis_trigger) {\n        setCrisisAssessment(data);\n        setShowCrisisModal(true);\n      } else {\n        setPatientResponseBubble(data);\n      }\n      \n      // Reset text inputs\n      setJournalText(\"\");\n      \n    } catch (err: any) {\n      console.error(\"Triage sub error:\", err);\n      setMicError(`Submission Failed: ${err.message || \'Check connection settings.\'}`);\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  const handleTextSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!journalText.trim()) return;\n    submitJournal({ text: journalText.trim() });\n  };\n\n  // Speak Patient Response aloud via Browser Speech Synthesis\n  const toggleSpeechSynthesis = (text: string) => {\n    if (ttsPlaying) {\n      window.speechSynthesis.cancel();\n      setTtsPlaying(false);\n    } else {\n      const utterance = new SpeechSynthesisUtterance(text);\n      utterance.onend = () => setTtsPlaying(false);\n      utterance.onerror = () => setTtsPlaying(false);\n      \n      // Try using a comforting, soft voice option if available\n      const voices = window.speechSynthesis.getVoices();\n      const preferred = voices.find(v => v.name.includes(\"Google\") || v.name.includes(\"Natural\"));\n      if (preferred) utterance.voice = preferred;\n      \n      setTtsPlaying(true);\n      window.speechSynthesis.speak(utterance);\n    }\n  };\n\n  // Acknowledge a crisis case on the Express node\n  const handleAcknowledge = async (id: string) => {\n    try {\n      const res = await fetch(\'/api/acknowledge-crisis\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ id })\n      });\n      if (res.ok) {\n        await fetchHistory();\n      }\n    } catch (err) {\n      console.error(\"Escalation action error:\", err);\n    }\n  };\n\n  const handleClearLogs = async () => {\n    if (confirm(\"Reset clinical triage logs to mock defaults? This will erase current session entries.\")) {\n      try {\n        const res = await fetch(\'/api/clear-history\', { method: \'DELETE\' });\n        if (res.ok) {\n          await fetchHistory();\n          setPatientResponseBubble(null);\n        }\n      } catch (err) {\n        console.error(\"Cleaning error:\", err);\n      }\n    }\n  };\n\n  // Clinical Dashboard Filters and Searches\n  const filteredTriage = triageHistory.filter(item => {\n    const summary = item.clinician_summary;\n    const matchesSearch = \n      summary.primary_stressor.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      summary.clinical_notes.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      summary.transcript.toLowerCase().includes(searchQuery.toLowerCase());\n      \n    if (riskFilter === \'All\') return matchesSearch;\n    return matchesSearch && summary.risk_level.toLowerCase() === riskFilter.toLowerCase();\n  });\n\n  // Calculate quick metrics for Clinician Dashboard\n  const analytics = {\n    total: triageHistory.length,\n    highRisk: triageHistory.filter(h => h.clinician_summary.risk_level.toLowerCase() === \'high\').length,\n    mediumRisk: triageHistory.filter(h => h.clinician_summary.risk_level.toLowerCase() === \'medium\').length,\n    lowRisk: triageHistory.filter(h => h.clinician_summary.risk_level.toLowerCase() === \'low\').length,\n    unacknowledgedCrisis: triageHistory.filter(h => h.crisis_trigger && !h.acknowledged).length,\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col font-sans selection:bg-blue-100 selection:text-blue-900 overflow-x-hidden\">\n      \n      {/* 1. Global View Navigation Toggle Bar (at the absolute top of the page) */}\n      <header className=\"sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs px-4 py-3\">\n        <div className=\"max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4\">\n          \n          {/* Brand/Product Name (Strict, Non-marketing, Humble name) */}\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 bg-gradient-to-tr from-blue-500 to-indigo-600 text-white rounded-xl shadow-xs\">\n              <Activity id=\"main-icon\" className=\"w-5 h-5 animate-pulse\" />\n            </div>\n            <div>\n              <h1 className=\"font-display font-semibold text-lg text-slate-900 tracking-tight\">\n                Empathetic Clinical Triage Hub\n              </h1>\n              <p className=\"text-xs text-slate-500 font-mono\">Gemma AI Engine</p>\n            </div>\n          </div>\n\n          {/* Simple toggle at the absolute top of the page to switch between \"Patient View\" and \"Clinician View\" */}\n          <div className=\"flex bg-slate-100 p-1 rounded-xl border border-slate-200\">\n            <button\n              id=\"btn-switch-patient\"\n              onClick={() => {\n                setActiveTab(\'patient\');\n                setPatientResponseBubble(null);\n                setMicVolume(0);\n              }}\n              className={`flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg transition-all duration-300 ${\n                activeTab === \'patient\' \n                  ? \'bg-white text-blue-600 shadow-xs\' \n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n              }`}\n            >\n              <User className=\"w-3.5 h-3.5\" />\n              Patient Portal\n            </button>\n            <button\n              id=\"btn-switch-clinician\"\n              onClick={() => {\n                setActiveTab(\'clinician\');\n                fetchHistory();\n              }}\n              className={`flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg transition-all duration-300 relative ${\n                activeTab === \'clinician\' \n                  ? \'bg-white text-slate-800 shadow-xs\' \n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n              }`}\n            >\n              <Server className=\"w-3.5 h-3.5\" />\n              Clinician View\n              {analytics.unacknowledgedCrisis > 0 && (\n                <span className=\"absolute -top-1 -right-1 flex h-2 w-2\">\n                  <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75\"></span>\n                  <span className=\"relative inline-flex rounded-full h-2 w-2 bg-red-500\"></span>\n                </span>\n              )}\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Container Workspace */}\n      <main className=\"flex-1 w-full max-w-7xl mx-auto px-4 py-6 md:py-10\">\n\n        {/* 2. API Key Error Notice Block */}\n        {isApiKeyMissing && (\n          <motion.div \n            initial={{ opacity: 0, y: -20 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-start gap-3.5 max-w-xl mx-auto\"\n          >\n            <ShieldAlert className=\"w-5 h-5 text-red-500 shrink-0 mt-0.5\" />\n            <div>\n              <h3 className=\"font-semibold text-red-900 text-sm\">Gemini API Key Needed</h3>\n              <p className=\"text-xs text-red-700 leading-relaxed mt-1\">\n                The Gemini model requires an active API key to process transcripts and sentiment categories.\n                Please add the <strong>GEMINI_API_KEY</strong> environment variable in your AI Studio \n                <strong> Settings &gt; Secrets</strong> tab of the compiler client.\n              </p>\n              <div className=\"mt-2.5 flex items-center gap-4\">\n                <span className=\"text-[10px] font-semibold font-mono bg-red-100 text-red-800 px-2 py-0.5 rounded uppercase\">Action Required</span>\n              </div>\n            </div>\n          </motion.div>\n        )}\n\n        <AnimatePresence mode=\"wait\">\n          {/* ======================================= */}\n          {/* PATIENT VIEW (Mobile-First, Calming Vibe) */}\n          {/* ======================================= */}\n          {activeTab === \'patient\' && (\n            <motion.div\n              key=\"patient-view\"\n              initial={{ opacity: 0, y: 15 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -15 }}\n              transition={{ duration: 0.3 }}\n              className=\"max-w-xl mx-auto flex flex-col items-center\"\n            >\n              {/* Introduction Card */}\n              <div className=\"text-center mb-8\">\n                <motion.div\n                  initial={{ scale: 0.95 }}\n                  animate={{ scale: 1 }}\n                  className=\"inline-block px-3.5 py-1 bg-blue-50 border border-blue-100 text-blue-700 font-display text-xs font-semibold rounded-full mb-3\"\n                >\n                  <span className=\"inline-block w-2 h-2 rounded-full bg-blue-500 animate-pulse mr-2\" />\n                  Your Encrypted Safe Space\n                </motion.div>\n                <h2 className=\"font-display text-3xl font-bold text-slate-800 tracking-tight\">\n                  Voice & Text Journal Triage\n                </h2>\n                <p className=\"text-slate-500 text-sm mt-2 max-w-md mx-auto leading-relaxed\">\n                  Record a verbal voice journal or type a summary of how you are feeling right now. Our AI system will provide immediate care and escalate active crises to Tele MANAS staff.\n                </p>\n              </div>\n\n              {/* Patient Voice Journal Recording Space */}\n              <div className=\"w-full bg-white border border-slate-200/80 rounded-2xl p-6 shadow-xs relative mb-6\">\n                \n                <h3 className=\"text-sm font-semibold text-slate-700 font-display mb-4 text-center\">\n                  Voice Journal (Recommended for full triage analysis)\n                </h3>\n\n                <div className=\"flex flex-col items-center justify-center py-6\">\n                  \n                  {/* Big Voice Button */}\n                  <div className=\"relative\">\n                    {/* Pulsing ring during active record */}\n                    {isRecording && (\n                      <span className=\"absolute inset-0 rounded-full bg-blue-500/10 animate-ping\" />\n                    )}\n                    <motion.button\n                      id=\"btn-record-voice\"\n                      onClick={isRecording ? stopRecording : startRecording}\n                      whileHover={{ scale: 1.04 }}\n                      whileTap={{ scale: 0.96 }}\n                      className={`relative z-10 w-24 h-24 rounded-full flex flex-col items-center justify-center transition-all duration-300 ${\n                        isRecording \n                          ? \'bg-red-500 hover:bg-red-600 text-white shadow-lg shadow-red-500/20\' \n                          : \'bg-gradient-to-tr from-blue-500 to-indigo-600 hover:opacity-95 text-white shadow-md shadow-blue-500/15\'\n                      }`}\n                    >\n                      {isRecording ? (\n                        <Square className=\"w-8 h-8 text-white\" />\n                      ) : (\n                        <Mic className=\"w-8 h-8 text-white\" />\n                      )}\n                      <span className=\"text-[10px] uppercase tracking-wider font-semibold font-mono mt-1\">\n                        {isRecording ? \"Stop\" : \"Record\"}\n                      </span>\n                    </motion.button>\n                  </div>\n\n                  {/* Dynamic Visual Feedback / Waveform Simulation */}\n                  <div className=\"h-14 w-full flex items-center justify-center gap-1.5 mt-5\">\n                    {isRecording ? (\n                      <div className=\"flex items-center gap-1\">\n                        {/* Audio amplitude meter indicator lines */}\n                        {[...Array(12)].map((_, i) => {\n                          const randomHeightScale = 15 + Math.random() * (micVolume * 0.8 || 20);\n                          return (\n                            <motion.span\n                              key={i}\n                              animate={{ \n                                height: [12, randomHeightScale, 12] \n                              }}\n                              transition={{ \n                                duration: 0.5 + (i * 0.05), \n                                repeat: Infinity,\n                                ease: \"easeInOut\"\n                              }}\n                              className=\"w-1.5 rounded-full bg-gradient-to-t from-blue-500 to-indigo-600\"\n                              style={{ height: \'14px\' }}\n                            />\n                          );\n                        })}\n                      </div>\n                    ) : (\n                      <p className=\"text-xs text-slate-400 italic\">\n                        Tap record to start capturing mic audio\n                      </p>\n                    )}\n                  </div>\n\n                  {/* Timer */}\n                  {isRecording && (\n                    <motion.div \n                      initial={{ opacity: 0 }}\n                      animate={{ opacity: 1 }}\n                      className=\"mt-2 text-sm font-semibold font-mono text-red-500 flex items-center gap-2\"\n                    >\n                      <span className=\"w-2.5 h-2.5 rounded-full bg-red-600 animate-pulse\" />\n                      {formatTime(recordingSeconds)}\n                    </motion.div>\n                  )}\n\n                  {/* Recording Status / Mic Errors */}\n                  {micError && (\n                    <p className=\"mt-4 text-xs font-medium text-red-500 bg-red-50 p-2.5 rounded-lg border border-red-100 text-center leading-relaxed\">\n                      {micError}\n                    </p>\n                  )}\n                </div>\n              </div>\n\n              {/* Text Area Form */}\n              <div className=\"w-full bg-white border border-slate-200/80 rounded-2xl p-6 shadow-xs mb-8\">\n                <form id=\"patient-text-form\" onSubmit={handleTextSubmit}>\n                  <label htmlFor=\"journal-input\" className=\"block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 font-display\">\n                    Or type your journal entry here...\n                  </label>\n                  <textarea\n                    id=\"journal-input\"\n                    value={journalText}\n                    onChange={(e) => setJournalText(e.target.value)}\n                    placeholder=\"Briefly share what you are going through, or explain what is on your mind...\"\n                    disabled={isRecording || isSubmitting}\n                    className=\"w-full h-32 px-4 py-3 text-slate-700 placeholder-slate-400 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-100 focus:border-blue-500 transition-all duration-200 resize-none outline-none text-sm leading-relaxed\"\n                  />\n                  \n                  <div className=\"flex items-center justify-between mt-4\">\n                    <span className=\"text-[10px] text-slate-400 font-mono\">\n                      {journalText.length} characters\n                    </span>\n                    <button\n                      id=\"btn-submit-journal\"\n                      type=\"submit\"\n                      disabled={isSubmitting || !journalText.trim() || isRecording}\n                      className=\"flex items-center gap-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-xs font-semibold px-5 py-2.5 rounded-xl shadow-xs disabled:opacity-40 transition-all duration-200 cursor-pointer\"\n                    >\n                      {isSubmitting ? (\n                        <>\n                          <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                          Submitting to Gemma...\n                        </>\n                      ) : (\n                        <>\n                          <Send className=\"w-3.5 h-3.5\" />\n                          Submit to Gemma\n                        </>\n                      )}\n                    </button>\n                  </div>\n                </form>\n              </div>\n\n              {/* Submission Analysis / Skeleton State */}\n              {isSubmitting && (\n                <div id=\"loading-assessment\" className=\"w-full bg-white border border-blue-100 rounded-2xl p-6 shadow-xs text-center border-dashed py-12 animate-pulse mb-8\">\n                  <div className=\"inline-flex p-3 bg-blue-50 text-blue-600 rounded-2xl mb-4\">\n                    <Sparkles className=\"w-6 h-6 animate-spin\" />\n                  </div>\n                  <h4 className=\"font-semibold text-sm text-slate-800\">Processing Journal Analysis</h4>\n                  <p className=\"text-xs text-slate-500 mt-2 max-w-sm mx-auto leading-relaxed\">\n                    Gemma AI is processing the transcript data, analyzing psychological stressors, rating risk levels, and drafting personal support validations.\n                  </p>\n                </div>\n              )}\n\n              {/* 3. Empathetic Support Output Bubble */}\n              {patientResponseBubble && (\n                <motion.div\n                  id=\"patient-response-card\"\n                  initial={{ opacity: 0, scale: 0.98 }}\n                  animate={{ opacity: 1, scale: 1 }}\n                  className=\"w-full bg-gradient-to-tr from-blue-50/50 to-indigo-50/50 border border-blue-100 rounded-2xl p-5 mb-8 relative\"\n                >\n                  <div className=\"flex items-center justify-between border-b border-blue-100 pb-3 h-8 mb-4\">\n                    <div className=\"flex items-center gap-2 text-blue-700 text-xs font-semibold\">\n                      <Sparkles className=\"w-4 h-4 text-blue-500\" />\n                      Patient Response Validation\n                    </div>\n                    \n                    <button\n                      id=\"btn-voice-tts\"\n                      onClick={() => toggleSpeechSynthesis(patientResponseBubble.patient_response)}\n                      className={`text-[10px] font-semibold flex items-center gap-1.5 px-3 py-1 bg-white rounded-full border border-blue-200 transition-colors ${\n                        ttsPlaying ? \'text-red-500 border-red-200 bg-red-50\' : \'text-blue-600 hover:bg-slate-100\'\n                      }`}\n                    >\n                      {ttsPlaying ? (\n                        <>\n                          <VolumeX className=\"w-3 h-3\" />\n                          Stop audio\n                        </>\n                      ) : (\n                        <>\n                          <Volume2 className=\"w-3 h-3\" />\n                          Listen aloud\n                        </>\n                      )}\n                    </button>\n                  </div>\n                  \n                  {/* Calming Speech Bubble */}\n                  <div className=\"text-slate-800 text-sm leading-relaxed italic bg-white p-4 rounded-xl border border-blue-50 shadow-xs relative\">\n                    <span className=\"absolute -top-2 left-6 w-4 h-4 bg-white border-t border-l border-blue-50 transform rotate-45\" />\n                    \"{patientResponseBubble.patient_response}\"\n                  </div>\n\n                  <p className=\"text-[10px] text-slate-400 text-right mt-3 font-mono\">\n                    Analysis Completed &bull; Risk Assessment: {patientResponseBubble.clinician_summary.risk_level}\n                  </p>\n                </motion.div>\n              )}\n\n              {/* Patient Safety disclaimer badge */}\n              <div className=\"flex items-center gap-2 text-xs text-slate-400 bg-slate-100/60 px-4 py-2.5 rounded-xl border border-slate-200/50 max-w-sm\">\n                <Heart className=\"w-3.5 h-3.5 text-blue-500 shrink-0\" />\n                <span>Self-help tools do not replace critical in-person professional counseling.</span>\n              </div>\n\n            </motion.div>\n          )}\n\n          {/* ======================================= */}\n          {/* CLINICIAN VIEW (Responsive Dashboard) */}\n          {/* ======================================= */}\n          {activeTab === \'clinician\' && (\n            <motion.div\n              key=\"clinician-view\"\n              initial={{ opacity: 0, y: 15 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -15 }}\n              transition={{ duration: 0.3 }}\n              className=\"space-y-6\"\n            >\n              {/* Diagnostic Overview Metric Cards */}\n              <div className=\"grid grid-cols-2 lg:grid-cols-5 gap-3.5\">\n                \n                <div className=\"bg-white p-4.5 rounded-xl border border-slate-200/80 shadow-xs\">\n                  <div className=\"flex justify-between items-start\">\n                    <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider font-mono\">Total cases</span>\n                    <span className=\"p-1 text-blue-600 bg-blue-50 rounded-lg\"><Activity className=\"w-4 h-4\" /></span>\n                  </div>\n                  <h3 className=\"text-2xl font-bold tracking-tight text-slate-800 mt-2\">{analytics.total}</h3>\n                  <p className=\"text-[10px] text-slate-400 mt-1 font-mono\">Combined logs queue</p>\n                </div>\n\n                <div className=\"bg-white p-4.5 rounded-xl border border-slate-200/80 shadow-xs relative overflow-hidden\">\n                  <div className=\"absolute top-0 left-0 w-1.5 h-full bg-red-500\" />\n                  <div className=\"flex justify-between items-start\">\n                    <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider font-mono\">Active Crisis</span>\n                    <span className=\"p-1 text-red-600 bg-red-50 rounded-lg\"><ShieldAlert className=\"w-4 h-4 animate-bounce\" /></span>\n                  </div>\n                  <h3 className=\"text-2xl font-bold tracking-tight text-red-600 mt-2\">{analytics.highRisk}</h3>\n                  <p className=\"text-[10px] text-red-500 mt-1 font-mono font-semibold\">Immediate escalation required</p>\n                </div>\n\n                <div className=\"bg-white p-4.5 rounded-xl border border-slate-200/80 shadow-xs\">\n                  <div className=\"flex justify-between items-start\">\n                    <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider font-mono\">Medium Risk</span>\n                    <span className=\"p-1 text-amber-500 bg-amber-50 rounded-lg\"><AlertTriangle className=\"w-4 h-4\" /></span>\n                  </div>\n                  <h3 className=\"text-2xl font-bold tracking-tight text-amber-600 mt-2\">{analytics.mediumRisk}</h3>\n                  <p className=\"text-[10px] text-slate-400 mt-1 font-mono\">Supportive follow-up</p>\n                </div>\n\n                <div className=\"bg-white p-4.5 rounded-xl border border-slate-200/80 shadow-xs\">\n                  <div className=\"flex justify-between items-start\">\n                    <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider font-mono\">Low Risk</span>\n                    <span className=\"p-1 text-green-500 bg-green-50 rounded-lg\"><CheckCircle className=\"w-4 h-4\" /></span>\n                  </div>\n                  <h3 className=\"text-2xl font-bold tracking-tight text-green-600 mt-2\">{analytics.lowRisk}</h3>\n                  <p className=\"text-[10px] text-slate-400 mt-1 font-mono\">Self guide interventions</p>\n                </div>\n\n                <div className=\"bg-white p-4.5 rounded-xl border border-slate-200/80 shadow-xs col-span-2 lg:col-span-1 flex flex-col justify-between\">\n                  <div>\n                    <h4 className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider font-mono\">Platform Admin</h4>\n                    <p className=\"text-xs text-slate-500 mt-1\">Manage active server records database</p>\n                  </div>\n                  <button\n                    id=\"btn-clear-logs\"\n                    onClick={handleClearLogs}\n                    className=\"mt-3.5 flex items-center justify-center gap-1.5 py-1.5 border border-slate-200 text-slate-600 hover:text-red-600 hover:border-red-100 hover:bg-red-50 text-[10px] font-bold rounded-lg transition-colors cursor-pointer\"\n                  >\n                    <Trash2 className=\"w-3 h-3\" />\n                    Reset History Logs\n                  </button>\n                </div>\n              </div>\n\n              {/* Search & Filter Toolbar */}\n              <div className=\"bg-white rounded-xl border border-slate-200 p-4 flex flex-col md:flex-row items-center justify-between gap-4\">\n                \n                {/* Search Bar */}\n                <div className=\"relative w-full md:w-80\">\n                  <span className=\"absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 pointer-events-none\">\n                    <Search className=\"w-4 h-4\" />\n                  </span>\n                  <input\n                    id=\"search-assessments\"\n                    type=\"text\"\n                    value={searchQuery}\n                    onChange={(e) => setSearchQuery(e.target.value)}\n                    placeholder=\"Search stressors, transcript, clinical notes...\"\n                    className=\"w-full pl-9 pr-4 py-2 bg-slate-50 text-slate-700 placeholder-slate-400 border border-slate-200 rounded-lg text-xs focus:bg-white focus:ring-2 focus:ring-blue-100 focus:border-blue-500 transition-all outline-none\"\n                  />\n                </div>\n\n                {/* Filter Buttons */}\n                <div className=\"flex items-center gap-2.5 w-full md:w-auto overflow-x-auto pb-1 md:pb-0\">\n                  <span className=\"text-[10px] text-slate-400 font-bold uppercase tracking-wider font-mono flex items-center gap-1.5 select-none whitespace-nowrap\">\n                    <Filter className=\"w-3.5 h-3.5 text-slate-400\" />\n                    Risk triage filter:\n                  </span>\n                  \n                  <div className=\"flex items-center gap-1 bg-slate-100 p-0.5 rounded-lg border border-slate-200\">\n                    {([\'All\', \'Low\', \'Medium\', \'High\'] as const).map((r) => (\n                      <button\n                        key={r}\n                        onClick={() => setRiskFilter(r)}\n                        className={`px-3 py-1 text-[10px] font-bold rounded-md transition-all ${\n                          riskFilter === r \n                            ? \'bg-white text-slate-800 shadow-xs\' \n                            : \'text-slate-500 hover:text-slate-800\'\n                        }`}\n                      >\n                        {r}\n                      </button>\n                    ))}\n                  </div>\n\n                  <button\n                    id=\"btn-refresh-history\"\n                    onClick={fetchHistory}\n                    className=\"p-1 px-2.5 border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 rounded-lg transition-all flex items-center gap-1 text-[10px] font-bold cursor-pointer whitespace-nowrap\"\n                  >\n                    <RefreshCw className=\"w-3 h-3\" />\n                    Reload Queue\n                  </button>\n                </div>\n              </div>\n\n              {/* 3. Patients Card Queue Grid */}\n              <div id=\"patient-cards-queue\" className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n                <AnimatePresence>\n                  {filteredTriage.length > 0 ? (\n                    filteredTriage.map((assessment) => {\n                      const summary = assessment.clinician_summary;\n                      const isCrisis = assessment.crisis_trigger;\n                      const isHigh = summary.risk_level.toLowerCase() === \'high\';\n                      const isMedium = summary.risk_level.toLowerCase() === \'medium\';\n                      \n                      // Theme configs per card\n                      let riskBadgeStyle = \'bg-slate-100 text-slate-700 border-slate-200\';\n                      if (isHigh || isCrisis) riskBadgeStyle = \'bg-red-50 text-red-700 border-red-200 animate-pulse\';\n                      else if (isMedium) riskBadgeStyle = \'bg-amber-50 text-amber-700 border-amber-200\';\n                      else riskBadgeStyle = \'bg-green-50 text-green-700 border-green-200\';\n\n                      return (\n                        <motion.div\n                          key={assessment.id}\n                          layout\n                          id={`card-${assessment.id}`}\n                          initial={{ opacity: 0, scale: 0.95 }}\n                          animate={{ opacity: 1, scale: 1 }}\n                          exit={{ opacity: 0, scale: 0.95 }}\n                          className={`flex flex-col relative rounded-2xl border transition-all duration-300 p-5 ${\n                            isCrisis \n                              ? assessment.acknowledged \n                                ? \'bg-red-50/35 border-red-200/60 shadow-xs\' \n                                : \'bg-red-100/90 border-red-300 shadow-lg shadow-red-100/50\'\n                              : \'bg-white border-slate-200/80 hover:shadow-md\'\n                          }`}\n                        >\n                          {/* RED ALERT LOGIC: If crisis_trigger: true, warning red and header banner shows */}\n                          {isCrisis && (\n                            <div className=\"absolute top-0 inset-x-0 bg-red-600 text-white rounded-t-2xl py-1.5 px-4 font-display font-bold text-[10px] tracking-wider uppercase flex items-center justify-between shadow-xs\">\n                              <span className=\"flex items-center gap-1\">\n                                <span className=\"w-2 h-2 rounded-full bg-white animate-ping\" />\n                                \342\232\240\357\270\217 Requires Immediate Escalation\n                              </span>\n                              {!assessment.acknowledged ? (\n                                <span className=\"bg-white/20 text-[8px] tracking-widest px-1.5 py-0.5 rounded font-mono font-bold\">CRITICAL QUEUE</span>\n                              ) : (\n                                <span className=\"text-red-100 text-[8px] font-mono\">STAFF CONTACTED</span>\n                              )}\n                            </div>\n                          )}\n\n                          {/* Spacing adjustments if crisis header is showing */}\n                          <div className={isCrisis ? \'pt-4\' : \'\'}>\n                            {/* Card Top Title Info */}\n                            <div className=\"flex items-start justify-between gap-2.5 mt-2\">\n                              <div>\n                                <span className=\"text-[9px] font-mono text-slate-400 uppercase tracking-widest leading-none\">PRIMARY STRESSOR</span>\n                                <h4 className=\"font-semibold text-slate-800 text-sm mt-0.5 tracking-tight font-display\">{summary.primary_stressor}</h4>\n                              </div>\n                              <span className={`px-2.5 py-1 text-[10px] font-bold border rounded-full ${riskBadgeStyle}`}>\n                                {summary.risk_level} Risk\n                              </span>\n                            </div>\n\n                            {/* Transcript Content */}\n                            <div className=\"mt-4 bg-slate-50/80 p-3 rounded-xl border border-slate-100\">\n                              <span className=\"text-[9px] font-bold font-mono text-slate-400 block tracking-wider uppercase mb-1\"> Verbatim Patient Transcript</span>\n                              <p className=\"text-xs text-slate-600 italic leading-relaxed font-sans\">\n                                \"{summary.transcript}\"\n                              </p>\n                            </div>\n\n                            {/* Clinical Notes Section */}\n                            <div className=\"mt-4 flex-1\">\n                              <span className=\"text-[9px] font-bold font-mono text-slate-400 block tracking-wider uppercase mb-1 flex items-center gap-1\">\n                                <FileText className=\"w-3 h-3 text-slate-400\" />\n                                Professional Triage Formulation\n                              </span>\n                              <p className=\"text-xs text-slate-700 leading-relaxed bg-white/50 p-2.5 rounded-lg border border-slate-100\">\n                                {summary.clinical_notes}\n                              </p>\n                            </div>\n\n                            {/* Crisis Modal / Staff action panel */}\n                            <div className=\"mt-5 pt-3.5 border-t border-slate-100 flex items-center justify-between gap-4\">\n                              <div className=\"flex items-center gap-1.5 text-[9px] font-mono text-slate-400\">\n                                <Clock className=\"w-3 h-3\" />\n                                {new Date(assessment.timestamp).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n                              </div>\n                              \n                              {/* Escalated buttons or details */}\n                              {isCrisis && !assessment.acknowledged && (\n                                <button\n                                  id={`btn-ack-${assessment.id}`}\n                                  onClick={() => handleAcknowledge(assessment.id)}\n                                  className=\"px-3.5 py-1.5 bg-red-600 hover:bg-red-700 text-white text-[10px] font-bold rounded-lg shadow-xs flex items-center gap-1 transition-all cursor-pointer\"\n                                >\n                                  <UserCheck className=\"w-3 h-3\" />\n                                  Acknowledge Dispatch\n                                </button>\n                              )}\n\n                              {isCrisis && assessment.acknowledged && (\n                                <div className=\"text-green-600 flex items-center gap-1 text-[10px] font-semibold\">\n                                  <CheckCircle className=\"w-3.5 h-3.5\" />\n                                  Emergency Handled\n                                </div>\n                              )}\n                            </div>\n                          </div>\n                        </motion.div>\n                      );\n                    })\n                  ) : (\n                    <div className=\"col-span-full bg-white border border-slate-200/80 p-12 text-center rounded-2xl\">\n                      <p className=\"text-sm text-slate-400 italic\">No triage records found matching the current filters.</p>\n                    </div>\n                  )}\n                </AnimatePresence>\n              </div>\n\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n      </main>\n\n      {/* 3. Crisis Modal Display overlay (Your safety is our priority) */}\n      <AnimatePresence>\n        {showCrisisModal && (\n          <motion.div\n            id=\"crisis-dialog\"\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            className=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-950/95 p-4 backdrop-blur-md\"\n          >\n            <motion.div\n              initial={{ scale: 0.95, y: 10 }}\n              animate={{ scale: 1, y: 0 }}\n              exit={{ scale: 0.95, y: 10 }}\n              className=\"bg-zinc-900 border border-red-500/30 max-w-lg w-full rounded-2xl overflow-hidden shadow-2xl relative\"\n            >\n              {/* Emergency indicator stripe */}\n              <div className=\"h-2 bg-gradient-to-r from-red-500 via-orange-600 to-red-500 animate-pulse\" />\n              \n              <div className=\"p-6 md:p-8 text-center text-white\">\n                \n                {/* Warning sign */}\n                <div className=\"inline-flex p-4.5 bg-red-600/10 text-red-500 border border-red-500/20 rounded-full mb-5 animate-pulse\">\n                  <ShieldAlert className=\"w-8 h-8\" />\n                </div>\n                \n                {/* Lock dialog title */}\n                <h3 className=\"font-display text-2xl md:text-3xl font-extrabold tracking-tight text-white\">\n                  Your safety is our priority.\n                </h3>\n                \n                <p className=\"text-zinc-400 text-sm mt-3 leading-relaxed max-w-sm mx-auto\">\n                  Gemma detected indications of self-harm or severe psychological crisis in this log. Please connect with emergency services or counselors now.\n                </p>\n\n                {/* Patient recorded prompt block */}\n                {crisisAssessment && (\n                  <div className=\"my-6 p-3 bg-zinc-800/80 border border-zinc-700 rounded-xl text-left\">\n                    <span className=\"text-[9px] font-bold font-mono text-red-400 block tracking-wider uppercase mb-1\">Verbatim Transcript Detected</span>\n                    <p className=\"text-xs text-zinc-300 italic leading-relaxed\">\n                      \"{crisisAssessment.clinician_summary.transcript}\"\n                    </p>\n                  </div>\n                )}\n\n                {/* Massive Red Hotlinks */}\n                <div className=\"space-y-3 mt-6\">\n                  <a\n                    id=\"link-telemanas\"\n                    href=\"tel:14416\"\n                    className=\"w-full h-14 bg-red-600 hover:bg-red-700 text-white font-semibold text-lg flex items-center justify-center gap-3.5 rounded-xl border border-red-500/40 shadow-lg shadow-red-600/15 group transition-all\"\n                  >\n                    <PhoneCall className=\"w-5 h-5 group-hover:animate-bounce\" />\n                    Call Tele MANAS (14416)\n                  </a>\n                  \n                  <a\n                    id=\"link-emergency\"\n                    href=\"tel:112\"\n                    className=\"w-full h-14 bg-orange-600 hover:bg-orange-700 text-white font-semibold text-lg flex items-center justify-center gap-3.5 rounded-xl border border-orange-500/40 shadow-lg shadow-orange-600/15 group transition-all\"\n                  >\n                    <PhoneCall className=\"w-5 h-5 group-hover:animate-bounce\" />\n                    Call National Emergency (112)\n                  </a>\n                </div>\n\n                <div className=\"mt-8 pt-5 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-500\">\n                  <span className=\"font-mono\">Triage Code: Esc-14416</span>\n                  \n                  {/* Exit bypass strictly for debug/testing/demonstration triage flows */}\n                  <button\n                    id=\"btn-close-crisis-modal\"\n                    onClick={() => {\n                      setShowCrisisModal(false);\n                      setCrisisAssessment(null);\n                    }}\n                    className=\"text-zinc-400 hover:text-white border-b border-dashed border-zinc-500 hover:border-white transition-colored bg-transparent outline-none cursor-pointer\"\n                  >\n                    Dismiss Emergency Alert\n                  </button>\n                </div>\n              </div>\n            </motion.div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* Footer System Credits */}\n      <footer className=\"mt-auto bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-400 font-mono\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2\">\n          <span>&copy; {new Date().getFullYear()} Clinical Triage Panel - Powered by Gemini Flash</span>\n          <div className=\"flex gap-4\">\n            <a href=\"https://github.com/google-gemini/google-genai\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"hover:text-slate-600 flex items-center gap-1\">\n              Google GenAI <ExternalLink className=\"w-3 h-3\" />\n            </a>\n          </div>\n        </div>\n      </footer>\n\n    </div>\n  );\n}\n"
    }
