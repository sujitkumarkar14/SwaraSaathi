rounded-xl text-left\">\n                    <span className=\"text-[9px] font-bold font-mono text-red-400 block tracking-wider uppercase mb-1\">Verbatim Transcript Detected</span>\n                    <p className=\"text-xs text-zinc-300 italic leading-relaxed\">\n                      \"{crisisAssessment.clinician_summary.transcript}\"\n                    </p>\n                  </div>\n                )}\n\n                {/* Massive Red Hotlinks */}\n                <div className=\"space-y-3 mt-6\">\n                  <a\n                    id=\"link-telemanas\"\n                    href=\"tel:14416\"\n                    className=\"w-full h-14 bg-red-600 hover:bg-red-700 text-white font-semibold text-lg flex items-center justify-center gap-3.5 rounded-xl border border-red-500/40 shadow-lg shadow-red-600/15 group transition-all\"\n                  >\n                    <PhoneCall className=\"w-5 h-5 group-hover:animate-bounce\" />\n                    Call Tele MANAS (14416)\n                  </a>\n                  \n                  <a\n                    id=\"link-emergency\"\n                    href=\"tel:112\"\n                    className=\"w-full h-14 bg-orange-600 hover:bg-orange-700 text-white font-semibold text-lg flex items-center justify-center gap-3.5 rounded-xl border border-orange-500/40 shadow-lg shadow-orange-600/15 group transition-all\"\n                  >\n                    <PhoneCall className=\"w-5 h-5 group-hover:animate-bounce\" />\n                    Call National Emergency (112)\n                  </a>\n                </div>\n\n                <div className=\"mt-8 pt-5 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-500\">\n                  <span className=\"font-mono\">Triage Code: Esc-14416</span>\n                  \n                  {/* Exit bypass strictly for debug/testing/demonstration triage flows */}\n                  <button\n                    id=\"btn-close-crisis-modal\"\n                    onClick={() => {\n                      setShowCrisisModal(false);\n                      setCrisisAssessment(null);\n                    }}\n                    className=\"text-zinc-400 hover:text-white border-b border-dashed border-zinc-500 hover:border-white transition-colored bg-transparent outline-none cursor-pointer\"\n                  >\n                    Dismiss Emergency Alert\n                  </button>\n                </div>\n              </div>\n            </motion.div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* Footer System Credits */}\n      <footer className=\"mt-auto bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-400 font-mono\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2\">\n          <span>&copy; {new Date().getFullYear()} Clinical Triage Panel - Powered by Gemini Flash</span>\n          <div className=\"flex gap-4\">\n            <a href=\"https://github.com/google-gemini/google-genai\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"hover:text-slate-600 flex items-center gap-1\">\n              Google GenAI <ExternalLink className=\"w-3 h-3\" />\n            </a>\n          </div>\n        </div>\n      </footer>"
      replacement_content: "      {/* 3. Crisis Modal Display overlay (Your safety is our priority) */}\n      <AnimatePresence>\n        {showCrisisModal && (\n          <motion.div\n            id=\"crisis-dialog\"\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            className=\"fixed inset-0 z-50 flex items-center justify-center bg-[#1A1A1A]/95 p-4 backdrop-blur-md\"\n          >\n            <motion.div\n              initial={{ scale: 0.95, y: 10 }}\n              animate={{ scale: 1, y: 0 }}\n              exit={{ scale: 0.95, y: 10 }}\n              className=\"bg-white border border-[#E5E5E5] max-w-lg w-full rounded-2xl overflow-hidden shadow-2xl relative\"\n            >\n              <div className=\"p-8 text-center text-[#1A1A1A]\">\n                \n                {/* Warning sign */}\n                <div className=\"inline-flex p-4 bg-red-50 text-red-600 border border-red-200 rounded-full mb-5\">\n                  <ShieldAlert className=\"w-8 h-8\" />\n                </div>\n                \n                {/* Lock dialog title */}\n                <h3 className=\"font-display text-3xl font-medium tracking-tight text-[#1A1A1A]\">\n                  Your safety is our priority.\n                </h3>\n                \n                <p className=\"text-[#6)66] text-[14px] mt-3 leading-relaxed max-w-sm mx-auto font-serif italic text-[#444]\">\n                  Our triage evaluation detected critical stressors. Please connect with immediate professional counselors or emergency facilities now.\n                </p>\n\n                {/* Patient recorded prompt block */}\n                {crisisAssessment && (\n                  <div className=\"my-6 p-4 bg-[#F8F9FA] border border-[#E5E5E5] rounded-xl text-left\">\n                    <span className=\"text-[9px] font-bold font-mono text-red-600 block tracking-wider uppercase mb-1\">Detected Strain Index</span>\n                    <p className=\"text-xs text-[#333] italic font-serif leading-relaxed\">\n                      \"{crisisAssessment.clinician_summary.transcript}\"\n                    </p>\n                  </div>\n                )}\n\n                {/* Massive Red Hotlinks */}\n                <div className=\"space-y-3 mt-6\">\n                  <a\n                    id=\"link-telemanas\"\n                    href=\"tel:14416\"\n                    className=\"w-full h-14 bg-red-600 hover:bg-red-700 text-white font-semibold text-sm uppercase tracking-wider flex items-center justify-center gap-3 rounded-xl shadow-lg shadow-red-200 transition-all\"\n                  >\n                    <PhoneCall className=\"w-4 h-4\" />\n                    Call Tele MANAS (14416)\n                  </a>\n                  \n                  <a\n                    id=\"link-emergency\"\n                    href=\"tel:112\"\n                    className=\"w-full h-14 bg-[#1A1A1A] hover:bg-slate-800 text-white font-semibold text-sm uppercase tracking-wider flex items-center justify-center gap-3 rounded-xl shadow-lg shadow-slate-200 transition-all\"\n                  >\n                    <PhoneCall className=\"w-4 h-4\" />\n                    Call National Services (112)\n                  </a>\n                </div>\n\n                <div className=\"mt-8 pt-5 border-t border-[#E5E5E5] flex items-center justify-between text-[11px] text-[#888]\">\n                  <span className=\"font-mono\">COGNITIVE INDEX: ALERT</span>\n                  \n                  {/* Exit bypass strictly for debug/testing/demonstration triage flows */}\n                  <button\n                    id=\"btn-close-crisis-modal\"\n                    onClick={() => {\n                      setShowCrisisModal(false);\n                      setCrisisAssessment(null);\n                    }}\n                    className=\"text-red-600 hover:text-red-700 font-bold uppercase tracking-wider text-[10px] underline decoration-dotted transition-colors bg-transparent outline-none cursor-pointer\"\n                  >\n                    Dismiss Alert\n                  </button>\n                </div>\n              </div>\n            </motion.div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* Footer System Credits */}\n      <footer className=\"mt-auto bg-white border-t border-[#E5E5E5] py-6 text-center text-xs text-[#888] font-mono\">\n        <div className=\"max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2\">\n          <span>&copy; {new Date().getFullYear()} MindPortal AI Core. All records encrypted.</span>\n          <div className=\"flex gap-4\">\n            <a href=\"https://github.com/google-gemini/google-genai\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"hover:text-[#1A1A1A] flex items-center gap-1\">\n              Google GenAI <ExternalLink className=\"w-3 h-3\" />\n            </a>\n          </div>\n        </div>\n      </footer>"
    }
