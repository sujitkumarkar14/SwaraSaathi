    instruction: "Implement Downsampled, Mono 16-bit PCM WAV recording workflow in App.tsx"
    replacement_infos {
      original_chunk {
        target_content: "  // Web Audio Recording Handlers\n  const startRecording = async () => {\n    setMicError(null);\n    audioChunksRef.current = [];\n    setPatientResponseBubble(null);\n    \n    try {\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n      setIsRecording(true);\n      setRecordingSeconds(0);\n      \n      // Set up recorder\n      let recorder: MediaRecorder;\n      try {\n        recorder = new MediaRecorder(stream, { mimeType: \'audio/webm\' });\n      } catch (e) {\n        // Fallback for Safari or browsers that do not support webm audio codec\n        try {\n          recorder = new MediaRecorder(stream, { mimeType: \'audio/mp4\' });\n        } catch (innerErr) {\n          recorder = new MediaRecorder(stream);\n        }\n      }\n      \n      mediaRecorderRef.current = recorder;\n      \n      recorder.ondataavailable = (event) => {\n        if (event.data.size > 0) {\n          audioChunksRef.current.push(event.data);\n        }\n      };\n      \n      recorder.onstop = async () => {\n        setIsSubmitting(true);\n        const audioBlob = new Blob(audioChunksRef.current, { type: recorder.mimeType });\n        \n        // Convert Blob to base64 to send inside the strict JSON API request\n        const reader = new FileReader();\n        reader.readAsDataURL(audioBlob);\n        reader.onloadend = async () => {\n          const rawBase64 = reader.result as string;\n          const base64Audio = rawBase64.split(\',\')[1];\n          \n          await submitJournal({ \n            audio: base64Audio, \n            mimeType: recorder.mimeType \n          });\n        };\n        \n        // Quietly close stream capture tracks\n        stream.getTracks().forEach(track => track.stop());\n      };\n      \n      recorder.start(150); // Get chunks of data every 150ms\n      \n      // Setting up Web Audio API Frequency Spectrum analyzer\n      try {\n        const AudioContextConstructor = window.AudioContext || (window as any).webkitAudioContext;\n        const audioCtx = new AudioContextConstructor();\n        const source = audioCtx.createMediaStreamSource(stream);\n        const analyser = audioCtx.createAnalyser();\n        analyser.fftSize = 32;\n        source.connect(analyser);\n        \n        audioContextRef.current = audioCtx;\n        analyserRef.current = analyser;\n        \n        const bufferLength = analyser.frequencyBinCount;\n        const dataArray = new Uint8Array(bufferLength);\n        \n        const updateVisuals = () => {\n          if (!analyserRef.current) return;\n          analyserRef.current.getByteFrequencyData(dataArray);\n          let sum = 0;\n          for (let i = 0; i < bufferLength; i++) {\n            sum += dataArray[i];\n          }\n          const averageVolume = sum / bufferLength;\n          setMicVolume(averageVolume); // Normal ranges around 0-100\n          animationFrameRef.current = requestAnimationFrame(updateVisuals);\n        };\n        updateVisuals();\n      } catch (e) {\n        console.warn(\"Speech visualization not supported in iframe sandbox context.\", e);\n      }\n      \n    } catch (err: any) {\n      console.error(\"Mic hook error:\", err);\n      setMicError(\"Microphone access denied or unsupported in this sandbox. Please use the text entry method below or open the applet in a new window tab.\");\n      setIsRecording(false);\n    }\n  };\n\n  const stopRecording = () => {\n    if (mediaRecorderRef.current && isRecording) {\n      mediaRecorderRef.current.stop();\n      setIsRecording(false);\n      \n      if (animationFrameRef.current) {\n        cancelAnimationFrame(animationFrameRef.current);\n      }\n      if (audioContextRef.current) {\n        audioContextRef.current.close().catch(() => {});\n      }\n      setMicVolume(0);\n    }\n  };"
        replacement_content: "  // Web Audio Recording Handlers\n  const startRecording = async () => {\n    setMicError(null);\n    audioSamplesRef.current = [];\n    setPatientResponseBubble(null);\n    \n    try {\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n      micStreamRef.current = stream;\n      setIsRecording(true);\n      setRecordingSeconds(0);\n      \n      // Crucial: Instantiate AudioContext strictly at 16,000 Hz sample rate\n      const AudioContextConstructor = window.AudioContext || (window as any).webkitAudioContext;\n      const audioCtx = new AudioContextConstructor({ sampleRate: 16000 });\n      audioContextRef.current = audioCtx;\n      \n      const source = audioCtx.createMediaStreamSource(stream);\n      \n      // Create a ScriptProcessorNode with bufferSize 4096, 1 input channel, 1 output channel\n      const processor = audioCtx.createScriptProcessor(4096, 1, 1);\n      scriptProcessorRef.current = processor;\n      \n      source.connect(processor);\n      processor.connect(audioCtx.destination);\n      \n      processor.onaudioprocess = (e) => {\n        // Downmix / collect channel 0 (Mono)\n        const channelData = e.inputBuffer.getChannelData(0);\n        \n        // Put Float32 sample data to our buffer. We MUST copy since the input buffer is recycled.\n        audioSamplesRef.current.push(new Float32Array(channelData));\n        \n        // Calculate volume spectrum metric for visualizer feedback\n        let sum = 0;\n        for (let i = 0; i < channelData.length; i++) {\n          sum += Math.abs(channelData[i]);\n        }\n        const averageVolume = (sum / channelData.length) * 150; // scaled for responsive rendering\n        setMicVolume(Math.min(100, averageVolume));\n      };\n      \n    } catch (err: any) {\n      console.error(\"Mic hook error:\", err);\n      setMicError(\"Microphone access denied or unsupported in this sandbox. Please use the text entry method below or open the applet in a new window tab.\");\n      setIsRecording(false);\n    }\n  };\n\n  const stopRecording = () => {\n    if (isRecording) {\n      setIsRecording(false);\n      setIsSubmitting(true);\n      \n      // Stop media tracks\n      if (micStreamRef.current) {\n        micStreamRef.current.getTracks().forEach(track => track.stop());\n        micStreamRef.current = null;\n      }\n      \n      // Disconnect and close nodes\n      if (scriptProcessorRef.current) {\n        scriptProcessorRef.current.disconnect();\n        scriptProcessorRef.current = null;\n      }\n      \n      if (audioContextRef.current) {\n        audioContextRef.current.close().catch(() => {});\n        audioContextRef.current = null;\n      }\n      \n      setMicVolume(0);\n      \n      // process samples\n      const chunks = audioSamplesRef.current;\n      audioSamplesRef.current = [];\n      \n      if (chunks.length === 0) {\n        setIsSubmitting(false);\n        setMicError(\"No audio samples captured.\");\n        return;\n      }\n      \n      // Combine all samples into one contiguous Float32Array\n      const totalLength = chunks.reduce((acc, val) => acc + val.length, 0);\n      const samples = new Float32Array(totalLength);\n      let offset = 0;\n      for (const chunk of chunks) {\n        samples.set(chunk, offset);\n        offset += chunk.length;\n      }\n      \n      // Convert to standard 16-bit PCM WAV Blob at 16,000 Hz\n      try {\n        const wavBlob = encodeWAV(samples, 16000);\n        \n        // Encode into Base64 string to be sent inline to the server\n        const reader = new FileReader();\n        reader.readAsDataURL(wavBlob);\n        reader.onloadend = async () => {\n          const rawBase64 = reader.result as string;\n          const base64Audio = rawBase64.split(\',\')[1];\n          \n          await submitJournal({ \n            audio: base64Audio, \n            mimeType: \'audio/wav\' \n          });\n        };\n      } catch (err: any) {\n        console.error(\"WAV encoding failed:\", err);\n        setMicError(`WAV encoding failed: ${err.message}`);\n        setIsSubmitting(false);\n      }\n    }\n  };"
      }
      num_matches: 1
    }
  }
}
