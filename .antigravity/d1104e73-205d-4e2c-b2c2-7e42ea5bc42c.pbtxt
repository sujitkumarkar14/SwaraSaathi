ce Button */}\n                  <div className=\"relative\">\n                    {/* Pulsing ring during active record */}\n                    {isRecording && (\n                      <span className=\"absolute inset-0 rounded-full bg-blue-500/10 animate-ping\" />\n                    )}\n                    <motion.button\n                      id=\"btn-record-voice\"\n                      onClick={isRecording ? stopRecording : startRecording}\n                      whileHover={{ scale: 1.04 }}\n                      whileTap={{ scale: 0.96 }}\n                      className={`relative z-10 w-24 h-24 rounded-full flex flex-col items-center justify-center transition-all duration-300 ${\n                        isRecording \n                          ? \'bg-red-500 hover:bg-red-600 text-white shadow-lg shadow-red-500/20\' \n                          : \'bg-gradient-to-tr from-blue-500 to-indigo-600 hover:opacity-95 text-white shadow-md shadow-blue-500/15\'\n                      }`}\n                    >\n                      {isRecording ? (\n                        <Square className=\"w-8 h-8 text-white\" />\n                      ) : (\n                        <Mic className=\"w-8 h-8 text-white\" />\n                      )}\n                      <span className=\"text-[10px] uppercase tracking-wider font-semibold font-mono mt-1\">\n                        {isRecording ? \"Stop\" : \"Record\"}\n                      </span>\n                    </motion.button>\n                  </div>\n\n                  {/* Dynamic Visual Feedback / Waveform Simulation */}\n                  <div className=\"h-14 w-full flex items-center justify-center gap-1.5 mt-5\">\n                    {isRecording ? (\n                      <div className=\"flex items-center gap-1\">\n                        {/* Audio amplitude meter indicator lines */}\n                        {[...Array(12)].map((_, i) => {\n                          const randomHeightScale = 15 + Math.random() * (micVolume * 0.8 || 20);\n                          return (\n                            <motion.span\n                              key={i}\n                              animate={{ \n                                height: [12, randomHeightScale, 12] \n                              }}\n                              transition={{ \n                                duration: 0.5 + (i * 0.05), \n                                repeat: Infinity,\n                                ease: \"easeInOut\"\n                              }}\n                              className=\"w-1.5 rounded-full bg-gradient-to-t from-blue-500 to-indigo-600\"\n                              style={{ height: \'14px\' }}\n                            />\n                          );\n                        })}\n                      </div>\n                    ) : (\n                      <p className=\"text-xs text-slate-400 italic\">\n                        Tap record to start capturing mic audio\n                      </p>\n                    )}\n                  </div>\n\n                  {/* Timer */}\n                  {isRecording && (\n                    <motion.div \n                      initial={{ opacity: 0 }}\n                      animate={{ opacity: 1 }}\n                      className=\"mt-2 text-sm font-semibold font-mono text-red-500 flex items-center gap-2\"\n                    >\n                      <span className=\"w-2.5 h-2.5 rounded-full bg-red-600 animate-pulse\" />\n                      {formatTime(recordingSeconds)}\n                    </motion.div>\n                  )}\n\n                  {/* Recording Status / Mic Errors */}\n                  {micError && (\n                    <p className=\"mt-4 text-xs font-medium text-red-500 bg-red-50 p-2.5 rounded-lg border border-red-100 text-center leading-relaxed\">\n                      {micError}\n                    </p>\n                  )}\n                </div>\n              </div>\n\n              {/* Text Area Form */}\n              <div className=\"w-full bg-white border border-slate-200/80 rounded-2xl p-6 shadow-xs mb-8\">\n                <form id=\"patient-text-form\" onSubmit={handleTextSubmit}>\n                  <label htmlFor=\"journal-input\" className=\"block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 font-display\">\n                    Or type your journal entry here...\n                  </label>\n                  <textarea\n                    id=\"journal-input\"\n                    value={journalText}\n                    onChange={(e) => setJournalText(e.target.value)}\n                    placeholder=\"Briefly share what you are going through, or explain what is on your mind...\"\n                    disabled={isRecording || isSubmitting}\n                    className=\"w-full h-32 px-4 py-3 text-slate-700 placeholder-slate-400 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-100 focus:border-blue-500 transition-all duration-200 resize-none outline-none text-sm leading-relaxed\"\n                  />\n                  \n                  <div className=\"flex items-center justify-between mt-4\">\n                    <span className=\"text-[10px] text-slate-400 font-mono\">\n                      {journalText.length} characters\n                    </span>\n                    <button\n                      id=\"btn-submit-journal\"\n                      type=\"submit\"\n                      disabled={isSubmitting || !journalText.trim() || isRecording}\n                      className=\"flex items-center gap-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-xs font-semibold px-5 py-2.5 rounded-xl shadow-xs disabled:opacity-40 transition-all duration-200 cursor-pointer\"\n                    >\n                      {isSubmitting ? (\n                        <>\n                          <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                          Submitting to Gemma...\n                        </>\n                      ) : (\n                        <>\n                          <Send className=\"w-3.5 h-3.5\" />\n                          Submit to Gemma\n                        </>\n                      )}\n                    </button>\n                  </div>\n                </form>\n              </div>\n\n              {/* Submission Analysis / Skeleton State */}\n              {isSubmitting && (\n                <div id=\"loading-assessment\" className=\"w-full bg-white border border-blue-100 rounded-2xl p-6 shadow-xs text-center border-dashed py-12 animate-pulse mb-8\">\n                  <div className=\"inline-flex p-3 bg-blue-50 text-blue-600 rounded-2xl mb-4\">\n                    <Sparkles className=\"w-6 h-6 animate-spin\" />\n                  </div>\n                  <h4 className=\"font-semibold text-sm text-slate-800\">Processing Journal Analysis</h4>\n                  <p className=\"text-xs text-slate-500 mt-2 max-w-sm mx-auto leading-relaxed\">\n                    Gemma AI is processing the transcript data, analyzing psychological stressors, rating risk levels, and drafting personal support validations.\n                  </p>\n                </div>\n              )}\n\n              {/* 3. Empathetic Support Output Bubble */}\n              {patientResponseBubble && (\n                <motion.div\n                  id=\"patient-response-card\"\n                  initial={{ opacity: 0, scale: 0.98 }}\n                  animate={{ opacity: 1, scale: 1 }}\n                  className=\"w-full bg-gradient-to-tr from-blue-50/50 to-indigo-50/50 border border-blue-100 rounded-2xl p-5 mb-8 relative\"\n                >\n                  <div className=\"flex items-center justify-between border-b border-blue-100 pb-3 h-8 mb-4\">\n                    <div className=\"flex items-center gap-2 text-blue-700 text-xs font-semibold\">\n                      <Sparkles className=\"w-4 h-4 text-blue-500\" />\n                      Patient Response Validation\n                    </div>\n                    \n                    <button\n                      id=\"btn-voice-tts\"\n                      onClick={() => toggleSpeechSynthesis(patientResponseBubble.patient_response)}\n                      className={`text-[10px] font-semibold flex items-center gap-1.5 px-3 py-1 bg-white rounded-full border border-blue-200 transition-colors ${\n                        ttsPlaying ? \'text-red-500 border-red-200 bg-red-50\' : \'text-blue-600 hover:bg-slate-100\'\n                      }`}\n                    >\n                      {ttsPlaying ? (\n                        <>\n                          <VolumeX className=\"w-3 h-3\" />\n                          Stop audio\n                        </>\n                      ) : (\n                        <>\n                          <Volume2 className=\"w-3 h-3\" />\n                          Listen aloud\n                        </>\n                      )}\n                    </button>\n                  </div>\n                  \n                  {/* Calming Speech Bubble */}\n                  <div className=\"text-slate-800 text-sm leading-relaxed italic bg-white p-4 rounded-xl border border-blue-50 shadow-xs relative\">\n                    <span className=\"absolute -top-2 left-6 w-4 h-4 bg-white border-t border-l border-blue-50 transform rotate-45\" />\n                    \"{patientResponseBubble.patient_response}\"\n                  </div>\n\n                  <p className=\"text-[10px] text-slate-400 text-right mt-3 font-mono\">\n                    Analysis Completed &bull; Risk Assessment: {patientResponseBubble.clinician_summary.risk_level}\n                  </p>\n                </motion.div>\n              )}\n\n              {/* Patient Safety disclaimer badge */}\n              <div className=\"flex items-center gap-2 text-xs text-slate-400 bg-slate-100/60 px-4 py-2.5 rounded-xl border border-slate-200/50 max-w-sm\">\n                <Heart className=\"w-3.5 h-3.5 text-blue-500 shrink-0\" />\n                <span>Self-help tools do not replace critical in-person professional counseling.</span>\n              </div>\n\n            </motion.div>\n          )}"
      replacement_content: "          {activeTab === \'patient\' && (\n            <motion.div\n              key=\"patient-view\"\n              initial={{ opacity: 0, y: 15 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -15 }}\n              transition={{ duration: 0.3 }}\n              className=\"max-w-xl mx-auto flex flex-col items-center\"\n            >\n              {/* Introduction Card */}\n              <div className=\"text-center mb-10 w-full\">\n                <div className=\"space-y-4\">\n                  <h1 className=\"font-display text-5xl leading-tight text-[#1A1A1A] font-medium tracking-tight\">Good morning,<br />Sarah.</h1>\n                  <p className=\"text-[#666] leading-relaxed max-w-md mx-auto text-[14px]\">\n                    How are you feeling today? Your journal is your confidential space for reflection. Express your mind verbally or in writing below.\n                  </p>\n                </div>\n              </div>\n\n              {/* Patient Voice Journal Recording Space */}\n              <button\n                id=\"btn-record-voice\"\n                onClick={isRecording ? stopRecording : startRecording}\n                className=\"w-full group flex flex-col items-center justify-center py-14 border-2 border-dashed border-[#4A90E2] rounded-3xl bg-[#F0F7FF] hover:bg-[#E1EFFF] transition-all duration-300 relative focus:outline-none cursor-pointer mb-6\"\n              >\n                {isRecording && (\n                  <span className=\"absolute inset-0 rounded-3xl bg-[#4A90E2]/5 animate-pulse\" />\n                )}\n                \n                {/* Visualizer waves inside button if recording */}\n                {isRecording ? (\n                  <div className=\"w-16 h-16 bg-red-600 rounded-full flex items-center justify-center mb-4 shadow-lg shadow-red-200 animate-pulse\">\n                    <Square className=\"w-6 h-6 text-white\" />\n                  </div>\n                ) : (\n                  <div className=\"w-16 h-16 bg-[#4A90E2] rounded-full flex items-center justify-center mb-4 shadow-lg shadow-blue-200/40 group-hover:scale-105 transition-transform duration-300\">\n                    <Mic className=\"w-6 h-6 text-white\" />\n                  </div>\n                )}\n                \n                {isRecording ? (\n                  <>\n                    <span className=\"text-red-600 font-semibold tracking-wider uppercase text-xs\">Recording Voice...</span>\n                    <span className=\"text-red-500/80 text-xs mt-1.5 font-mono\">{formatTime(recordingSeconds)} &bull; Tap to stop & submit</span>\n                  </>\n                ) : (\n                  <>\n                    <span className=\"text-[#4A90E2] font-semibold tracking-wide text-sm\">Record Voice Journal</span>\n                    <span className=\"text-[#4A90E2]/60 text-xs mt-1\">Tap to start speaking</span>\n                  </>\n                )}\n\n                {/* Micro visualizer lines under button text only when recording */}\n                {isRecording && micVolume > 0 && (\n                  <div className=\"flex items-center gap-1.5 mt-5\">\n                    {[...Array(8)].map((_, i) => {\n                      const h = 4 + Math.random() * (micVolume * 0.5 || 15);\n                      return (\n                        <span \n                          key={i} \n                          className=\"w-1 rounded-full bg-red-600/70\"\n                          style={{ height: `${h}px` }}\n                        />\n                      );\n                    })}\n                  </div>\n                )}\n              </button>\n\n              {micError && (\n                <div className=\"w-full mb-6 text-xs font-semibold text-red-600 bg-red-50 p-3.5 rounded-2xl border border-red-100 text-center leading-relaxed\">\n                  {micError}\n                </div>\n              )}\n\n              {/* Text Area Form */}\n              <div className=\"w-full relative mb-8\">\n                <form id=\"patient-text-form\" onSubmit={handleTextSubmit} className=\"relative\">\n                  <textarea\n                    id=\"journal-input\"\n                    value={journalText}\n                    onChange={(e) => setJournalText(e.target.value)}\n                    placeholder=\"Or type your journal here...\"\n                    disabled={isRecording || isSubmitting}\n                    className=\"w-full h-36 p-5 bg-white focus:bg-white rounded-2xl border-none focus:ring-1 focus:ring-[#4A90E2] resize-none text-[14px] placeholder-[#999] outline-none text-[#1A1A1A] leading-relaxed transition-all pr-36 shadow-xs\"\n                  />\n                  <button\n                    id=\"btn-submit-journal\"\n                    type=\"submit\"\n                    disabled={isSubmitting || !journalText.trim() || isRecording}\n                    className=\"absolute bottom-4 right-4 bg-[#1A1A1A] text-white hover:bg-slate-800 disabled:bg-slate-100 disabled:text-slate-400 text-[10px] px-5 py-2 rounded-full font-bold uppercase tracking-wider transition-all duration-200 cursor-pointer shadow-xs\"\n                  >\n                    {isSubmitting ? \"Sending...\" : \"Submit to Gemma\"}\n                  </button>\n                </form>\n              </div>\n\n              {/* Submission Analysis / Skeleton State */}\n              {isSubmitting && (\n                <div id=\"loading-assessment\" className=\"w-full bg-[#F0F7FF] border border-[#D0E3F7]/80 rounded-2xl p-8 shadow-2xs text-center border-dashed py-14 animate-pulse mb-8\">\n                  <div className=\"inline-flex p-3 bg-white text-[#4A90E2] rounded-full mb-4 shadow-3xs\">\n                    <Sparkles className=\"w-5 h-5 animate-spin\" />\n                  </div>\n                  <h4 className=\"font-semibold text-xs uppercase tracking-widest text-[#4A90E2]\">Processing Journal Analysis</h4>\n                  <p className=\"text-xs text-slate-500 mt-2 max-w-sm mx-auto font-serif leading-relaxed italic\">\n                    Gemma AI is processing raw entry metrics, drafting clinical supportive insights, and formulating safe triage routes.\n                  </p>\n                </div>\n              )}\n\n              {/* 3. Empathetic Support Output Bubble (Pristine Editorial style) */}\n              {patientResponseBubble && (\n                <motion.div\n                  id=\"patient-response-card\"\n                  initial={{ opacity: 0, scale: 0.98 }}\n                  animate={{ opacity: 1, scale: 1 }}\n                  className=\"w-full bg-[#F0F7FF] p-6 rounded-2xl border border-[#D0E3F7] relative mb-8\"\n                >\n                  <div className=\"flex items-center justify-between mb-4 border-b border-[#D0E3F7] pb-3\">\n                    <p className=\"text-[11px] uppercase tracking-[0.2em] text-[#4A90E2] font-bold\">Gemma\'s Response</p>\n                    \n                    <button\n                      id=\"btn-voice-tts\"\n                      onClick={() => toggleSpeechSynthesis(patientResponseBubble.patient_response)}\n                      className={`text-[9px] font-bold uppercase tracking-wider flex items-center gap-1.5 px-3 py-1.5 bg-white rounded-full border border-blue-200 transition-all cursor-pointer ${\n                        ttsPlaying ? \'text-red-500 border-red-200 bg-red-50 animate-pulse\' : \'text-[#4A90E2] hover:bg-blue-50\'\n                      }`}\n                    >\n                      {ttsPlaying ? (\n                        <>\n                          <VolumeX className=\"w-3 h-3\" />\n                          Stop audio\n                        </>\n                      ) : (\n                        <>\n                          <Volume2 className=\"w-3 h-3\" />\n                          Listen aloud\n                        </>\n                      )}\n                    </button>\n                  </div>\n                  \n                  <p className=\"text-sm italic font-serif text-[#334E68] leading-relaxed\">\n                    \"{patientResponseBubble.patient_response}\"\n                  </p>\n\n                  <div className=\"mt-4 pt-3 border-t border-[#D0E3F7] flex justify-between items-center text-[9px] font-mono font-semibold text-blue-500/70\">\n                    <span>TRIAGE CODE CLASSIFIED</span>\n                    <span className=\"font-bold tracking-widest uppercase\">RISK ASSESSMENT: {patientResponseBubble.clinician_summary.risk_level}</span>\n                  </div>\n                </motion.div>\n              )}\n\n              {/* Patient Safety disclaimer badge */}\n              <div className=\"flex items-center justify-center gap-2.5 text-[11px] text-[#888] bg-white hover:bg-slate-50/50 px-5 py-3 rounded-2xl border border-slate-200/60 max-w-sm shadow-2xs font-serif italic text-center transition-colors\">\n                <Heart className=\"w-3.5 h-3.5 text-red-400 shrink-0\" />\n                <span>MindPortal self-help metrics do not substitute critical human therapy.</span>\n              </div>\n\n            </motion.div>\n          )}"
    }
