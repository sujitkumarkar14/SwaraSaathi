          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                : \'border-red-300 shadow-lg shadow-red-50/85\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
