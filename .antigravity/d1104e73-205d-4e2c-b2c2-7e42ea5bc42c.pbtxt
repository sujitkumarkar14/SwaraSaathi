        lines {
          text: "  view.setUint16(22, 1, true); // Mono (1 channel)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  view.setUint32(24, sampleRate, true);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  view.setUint32(28, sampleRate * 2, true); // Byte rate"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  view.setUint16(32, 2, true); // Block align"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  view.setUint16(34, 16, true); // Bits per sample"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  writeString(view, 36, \'data\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
