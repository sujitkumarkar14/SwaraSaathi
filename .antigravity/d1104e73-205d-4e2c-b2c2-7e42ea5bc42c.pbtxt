      original_chunk {
        target_content: "  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col font-sans selection:bg-blue-100 selection:text-blue-900 overflow-x-hidden\">\n      \n      {/* 1. Global View Navigation Toggle Bar (at the absolute top of the page) */}\n      <header className=\"sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs px-4 py-3\">\n        <div className=\"max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4\">\n          \n          {/* Brand/Product Name (Strict, Non-marketing, Humble name) */}\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 bg-gradient-to-tr from-blue-500 to-indigo-600 text-white rounded-xl shadow-xs\">\n              <Activity id=\"main-icon\" className=\"w-5 h-5 animate-pulse\" />\n            </div>\n            <div>\n              <h1 className=\"font-display font-semibold text-lg text-slate-900 tracking-tight\">\n                Empathetic Clinical Triage Hub\n              </h1>\n              <p className=\"text-xs text-slate-500 font-mono\">Gemma AI Engine</p>\n            </div>\n          </div>\n\n          {/* Simple toggle at the absolute top of the page to switch between \"Patient View\" and \"Clinician View\" */}\n          <div className=\"flex bg-slate-100 p-1 rounded-xl border border-slate-200\">\n            <button\n              id=\"btn-switch-patient\"\n              onClick={() => {\n                setActiveTab(\'patient\');\n                setPatientResponseBubble(null);\n                setMicVolume(0);\n              }}\n              className={`flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg transition-all duration-300 ${\n                activeTab === \'patient\' \n                  ? \'bg-white text-blue-600 shadow-xs\' \n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n              }`}\n            >\n              <User className=\"w-3.5 h-3.5\" />\n              Patient Portal\n            </button>\n            <button\n              id=\"btn-switch-clinician\"\n              onClick={() => {\n                setActiveTab(\'clinician\');\n                fetchHistory();\n              }}\n              className={`flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg transition-all duration-300 relative ${\n                activeTab === \'clinician\' \n                  ? \'bg-white text-slate-800 shadow-xs\' \n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n              }`}\n            >\n              <Server className=\"w-3.5 h-3.5\" />\n              Clinician View\n              {analytics.unacknowledgedCrisis > 0 && (\n                <span className=\"absolute -top-1 -right-1 flex h-2 w-2\">\n                  <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75\"></span>\n                  <span className=\"relative inline-flex rounded-full h-2 w-2 bg-red-500\"></span>\n                </span>\n              )}\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Container Workspace */}\n      <main className=\"flex-1 w-full max-w-7xl mx-auto px-4 py-6 md:py-10\">"
        replacement_content: "  return (\n    <div className=\"min-h-screen bg-[#F8F9FA] flex flex-col font-sans text-[#1A1A1A] selection:bg-[#E1EFFF] selection:text-[#1A1A1A] overflow-x-hidden\">\n      \n      {/* 1. Global View Navigation Toggle Bar (at the absolute top of the page) */}\n      <header className=\"sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-[#E5E5E5] px-6 py-4 shrink-0\">\n        <div className=\"max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4\">\n          \n          {/* Brand/Product Name (Strict, Non-marketing, Humble name) */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 bg-[#4A90E2] rounded-full flex items-center justify-center shadow-xs shrink-0\">\n              <div className=\"w-4 h-4 bg-white rounded-xs rotate-45\"></div>\n            </div>\n            <div>\n              <h1 className=\"font-display italic text-xl tracking-tight text-[#1A1A1A]\">\n                MindPortal <span className=\"text-[#A0A0A0] font-sans text-xs uppercase tracking-widest font-semibold ml-1\">AI Triage</span>\n              </h1>\n              <p className=\"text-[10px] text-[#A0A0A0] uppercase tracking-wider font-mono font-medium leading-none mt-0.5\">Dual-Purpose Support Core</p>\n            </div>\n          </div>\n\n          {/* Simple toggle at the absolute top of the page to switch between \"Patient View\" and \"Clinician View\" */}\n          <div className=\"flex bg-[#F0F2F5] p-1 rounded-full border border-slate-200/20\">\n            <button\n              id=\"btn-switch-patient\"\n              onClick={() => {\n                setActiveTab(\'patient\');\n                setPatientResponseBubble(null);\n                setMicVolume(0);\n              }}\n              className={`flex items-center gap-2 px-6 py-1.5 text-xs font-semibold rounded-full transition-all duration-300 cursor-pointer ${\n                activeTab === \'patient\' \n                  ? \'bg-white text-[#1A1A1A] shadow-sm\' \n                  : \'text-[#666] hover:text-[#1A1A1A]\'\n              }`}\n            >\n              <User className=\"w-3.5 h-3.5\" />\n              Patient Portal\n            </button>\n            <button\n              id=\"btn-switch-clinician\"\n              onClick={() => {\n                setActiveTab(\'clinician\');\n                fetchHistory();\n              }}\n              className={`flex items-center gap-2 px-6 py-1.5 text-xs font-semibold rounded-full transition-all duration-300 relative cursor-pointer ${\n                activeTab === \'clinician\' \n                  ? \'bg-white text-[#1A1A1A] shadow-sm\' \n                  : \'text-[#666] hover:text-[#1A1A1A]\'\n              }`}\n            >\n              <Server className=\"w-3.5 h-3.5\" />\n              Clinician View\n              {analytics.unacknowledgedCrisis > 0 && (\n                <span className=\"absolute top-1 right-2 flex h-2 w-2\">\n                  <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75\"></span>\n                  <span className=\"relative inline-flex rounded-full h-2 w-2 bg-red-500\"></span>\n                </span>\n              )}\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Container Workspace */}\n      <main className=\"flex-1 w-full max-w-7xl mx-auto px-6 py-6 md:py-10\">"
