        }
        lines {
          text: "                      let riskBadgeStyle = \'bg-slate-100 text-slate-700 border-slate-200\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      if (isHigh || isCrisis) riskBadgeStyle = \'bg-red-50 text-red-700 border-red-200 animate-pulse\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      else if (isMedium) riskBadgeStyle = \'bg-amber-50 text-amber-700 border-amber-200\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      else riskBadgeStyle = \'bg-green-50 text-green-700 border-green-200\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
