        lines {
          text: "                  {filteredTriage.length > 0 ? ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    filteredTriage.map((assessment) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
